<!-- security/security_rules.xml -->
<odoo>
    <data noupdate="1">
        <!-- Record rule for custom picking fields -->
        <record id="custom_picking_rule_warehouse_user" model="ir.rule">
            <field name="name">Warehouse User: Custom Picking Fields</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">
                ['|', ('shipping_priority', '!=', 'same_day'),
                      ('packing_station_id', 'in', [user.packing_station_ids])]
            </field>
            <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
        </record>
    </data>
</odoo>