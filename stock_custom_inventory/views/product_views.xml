<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_product_template_form_storage" model="ir.ui.view">
            <field name="name">product.template.form.storage</field>
            <field name="model">product.template</field>  <!-- Changed from product.product -->
            <field name="inherit_id" ref="product.product_template_form_view"/>  <!-- Changed reference -->
            <field name="priority">50</field>  <!-- Lower priority to ensure it loads -->
            <field name="arch" type="xml">
                <!-- Add a new tab in the notebook -->
                <xpath expr="//notebook" position="inside">
                    <page name="storage" string="Storage" invisible="type == 'service'">
                        <group>
                            <group string="Temperature Requirements">
                                <field name="storage_temperature" widget="radio"/>
                                <field name="shelf_life_days"/>
                            </group>
                            <group string="Stock Levels">
                                <field name="minimum_stock_level"/>
                                <field name="maximum_stock_level"/>
                            </group>
                            <group string="Warehouse Instructions" colspan="2">
                                <field name="warehouse_notes" nolabel="1" placeholder="Special handling instructions..."/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>